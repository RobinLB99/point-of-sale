{
  "name": "pos-system-angular-app",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:pos-system-angular-app": "node dist/pos-system-angular-app/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
